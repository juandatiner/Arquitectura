@model VistaPendientes
@{ ViewData["Titulo"] = "Compras pendientes"; var pesos = System.Globalization.CultureInfo.GetCultureInfo("es-CO"); }
<section class="tarjeta">
    <h1>Compras SSO</h1>
    <p>Cédula @Model.Nombre</p>
    @if (Model.Compras.Count == 0)
    {
        <p>No tiene compras SSO.</p>
    }
    @foreach (var compra in Model.Compras)
    {
        <article class="compra @(compra.NumeroCompra == Model.Resaltada ? "resaltada" : "")">
            <h2>Compra @compra.NumeroCompra</h2>
            <p class="valor">@compra.ValorTotal.ToString("C0", pesos)</p>
            <p><span class="estado" data-estado="@compra.Estado">@compra.Estado</span></p>
            @if (compra.Estado == "PENDIENTE")
            {
                <form method="post" action="/pagar" asp-antiforgery="true">
                    <input type="hidden" name="numeroCompra" value="@compra.NumeroCompra">
                    <label>Titular <input name="titular" autocomplete="cc-name" required></label>
                    <fieldset class="medios">
                        <legend>Medio de pago</legend>
                        <div class="medios-opciones">
                            <label class="medio"><input type="radio" name="medio" value="PSE" checked> PSE</label>
                            <label class="medio"><input type="radio" name="medio" value="TARJETA"> Tarjeta</label>
                        </div>
                    </fieldset>
                    <button type="submit">Pagar @compra.ValorTotal.ToString("C0", pesos)</button>
                </form>
            }
            else
            {
                <div class="detalle"><p>Referencia <strong>@compra.Referencia</strong></p><p>Reporte a SSO <strong>@compra.Reporte</strong></p></div>
            }
        </article>
    }
    <form class="salida" method="post" action="/salir" asp-antiforgery="true"><button class="secundario" type="submit">Salir</button></form>
</section>
