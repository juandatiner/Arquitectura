@model ResultadoPago
@{ ViewData["Titulo"] = "Pago realizado"; var pesos = System.Globalization.CultureInfo.GetCultureInfo("es-CO"); }
<section class="tarjeta">
    <span class="exito" aria-hidden="true">✓</span>
    <h1>Pago realizado</h1>
    <p class="valor">@Model.ValorPagado.ToString("C0", pesos)</p>
    <div class="detalle">
        <p>Compra <strong>@Model.NumeroCompra</strong></p>
        <p>Referencia YoPago <strong>@Model.Referencia</strong></p>
    </div>
    @if (Model.Reporte == "REPORTADO")
    {
        <p>SSO recibió su pago (@Model.ResultadoSso). Le llegará un mensaje al celular cuando la compra se complete.</p>
    }
    else
    {
        <p>Su pago quedó registrado. Estamos informándolo a SSO; le llegará un mensaje al celular.</p>
    }
    <form method="post" action="/salir" asp-antiforgery="true"><button type="submit">Terminar</button></form>
</section>
