<Project>
  <!-- Componentes .NET del diagrama: «Kestrel .NET 8» -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Nombres del diagrama en español (Repo, Srv, WS…) y métodos en camelCase como en el diagrama -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1716;CA1720;CA1724;CA1848;CA1852;CA2007;CA1031;CA1062;CA1515;CA1056;CA1054;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1869;IDE1006;CA1822;CA2227;CA1002</NoWarn>
  </PropertyGroup>
</Project>
