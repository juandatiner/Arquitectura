# Copiar a deploy/maquina-2/.env y llenar. Nunca subir el .env al repositorio. Si falta una variable, el stack no arranca.
# IP de la otra máquina que usa este stack (diagrama: Máquina 3 = 10.43.99.45)
MAQUINA3_IP=

# Registro y etiqueta de las imágenes linux/amd64
IMAGE_REGISTRY=
IMAGE_TAG=

# Clave de las bases de esta máquina
DB_CLAVE=
# DB COMPRA: debe ser igual en Máquina 3 (la usa MSCompra réplica 2)
DB_COMPRA_CLAVE=

# Deben ser iguales en Máquina 3 y coincidir con deploy/secretos/mom/usuarios.json
RABBITMQ_USUARIO=
RABBITMQ_CLAVE=

MAIL_REMITENTE=

# Límites de memoria por contenedor (formato de Docker, ej. 512m). Ver docs/modelo/observaciones.md #17
MEMORIA_MS=
MEMORIA_DB=
MEMORIA_MOM=
