# Copiar a deploy/maquina-1/.env y llenar. Nunca subir el .env al repositorio. Si falta una variable, el stack no arranca.
# IP de las otras máquinas (diagrama: Máquina 2 = 10.43.100.238, Máquina 3 = 10.43.99.45)
MAQUINA2_IP=
MAQUINA3_IP=

# Registro y etiqueta de las imágenes linux/amd64
IMAGE_REGISTRY=
IMAGE_TAG=

# Debe ser igual en Máquina 3
CREDENCIAL_YOPAGO=

# Límites de memoria por contenedor (formato de Docker, ej. 512m). Ver docs/modelo/observaciones.md #17
MEMORIA_MS=
MEMORIA_BALANCEADOR=
