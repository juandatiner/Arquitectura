# Copiar a deploy/maquina-3/.env y llenar. Nunca subir el .env al repositorio. Si falta una variable, el stack no arranca.
# IP de las otras máquinas (diagrama: Máquina 1 = 10.43.99.2, Máquina 2 = 10.43.100.238)
MAQUINA1_IP=
MAQUINA2_IP=

# Registro y etiqueta de las imágenes linux/amd64
IMAGE_REGISTRY=
IMAGE_TAG=

AD_ADMIN_CLAVE=
# Clave de las bases de esta máquina
DB_CLAVE=
# DB COMPRA (Máquina 2): debe ser igual en Máquina 2
DB_COMPRA_CLAVE=

# Deben ser iguales en Máquina 2 y coincidir con deploy/secretos/mom/usuarios.json
RABBITMQ_USUARIO=
RABBITMQ_CLAVE=

# Debe ser igual en Máquina 1
CREDENCIAL_YOPAGO=
TASA_IMPUESTO=

# Límites de memoria por contenedor (formato de Docker, ej. 512m). Ver docs/modelo/observaciones.md #15
MEMORIA_MS=
MEMORIA_DB=
MEMORIA_EXTERNOS=
